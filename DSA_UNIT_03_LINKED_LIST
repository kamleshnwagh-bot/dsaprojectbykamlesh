/*
 * HOSPITAL PATIENT MANAGEMENT SYSTEM
 * Subject : Data Structures and Algorithms (C++)
 * Concepts: Doubly Linked List, Stack, Array  (using struct only, no classes)
 *
 * Data structures used:
 *   1. Doubly Linked List -> stores admitted patient records (forward/backward traversal)
 *   2. Array              -> stores hospital beds (bed allocation / availability)
 *   3. Stack (array)      -> stores discharged patients (history + undo last discharge)
 */

#include <iostream>
#include <string>
#include <limits>
using namespace std;

#define MAX_BEDS 10      // total beds in the hospital (array size)
#define MAX_STACK 50     // max discharge history records

/* ------------------------------------------------------------------ */
/*                           STRUCTURES                                */
/* ------------------------------------------------------------------ */

// Node of the doubly linked list (one patient)
struct Patient {
    int id;
    string name;
    int age;
    string disease;
    int bedNo;           // bed allotted to the patient
    Patient *prev;       // pointer to previous node
    Patient *next;       // pointer to next node
};

// Doubly linked list holder
struct PatientList {
    Patient *head;
    Patient *tail;
    int count;
};

// Array element: one hospital bed
struct Bed {
    int bedNo;
    bool occupied;
    int patientId;       // 0 if bed is free
};

// Plain record (no pointers) kept in the stack after discharge
struct DischargedRecord {
    int id;
    string name;
    int age;
    string disease;
    int bedNo;
};

// Stack implemented using an array
struct Stack {
    DischargedRecord data[MAX_STACK];
    int top;
};

/* ------------------------------------------------------------------ */
/*                        INITIALIZATION                               */
/* ------------------------------------------------------------------ */

void initList(PatientList &list) {
    list.head = NULL;
    list.tail = NULL;
    list.count = 0;
}

void initBeds(Bed beds[]) {
    for (int i = 0; i < MAX_BEDS; i++) {
        beds[i].bedNo = i + 1;
        beds[i].occupied = false;
        beds[i].patientId = 0;
    }
}

void initStack(Stack &s) {
    s.top = -1;
}

/* ------------------------------------------------------------------ */
/*                        INPUT HELPERS                                */
/* ------------------------------------------------------------------ */

int readInt(const string &msg, int minVal, int maxVal) {
    int x;
    while (true) {
        cout << msg;
        if (cin >> x && x >= minVal && x <= maxVal) {
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            return x;
        }
        cout << "  Invalid input! Enter a number between " << minVal
             << " and " << maxVal << ".\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }
}

string readText(const string &msg) {
    string s;
    while (true) {
        cout << msg;
        getline(cin, s);
        if (!s.empty()) return s;
        cout << "  Input cannot be empty!\n";
    }
}

/* ------------------------------------------------------------------ */
/*                        STACK OPERATIONS                             */
/* ------------------------------------------------------------------ */

bool isStackEmpty(Stack &s) { return s.top == -1; }
bool isStackFull(Stack &s)  { return s.top == MAX_STACK - 1; }

bool push(Stack &s, DischargedRecord r) {
    if (isStackFull(s)) return false;
    s.data[++s.top] = r;
    return true;
}

bool pop(Stack &s, DischargedRecord &r) {
    if (isStackEmpty(s)) return false;
    r = s.data[s.top--];
    return true;
}

/* ------------------------------------------------------------------ */
/*                         BED (ARRAY) OPERATIONS                      */
/* ------------------------------------------------------------------ */

// returns first free bed number, or -1 if all beds are occupied
int findFreeBed(Bed beds[]) {
    for (int i = 0; i < MAX_BEDS; i++)
        if (!beds[i].occupied) return beds[i].bedNo;
    return -1;
}

void allocateBed(Bed beds[], int bedNo, int patientId) {
    beds[bedNo - 1].occupied = true;
    beds[bedNo - 1].patientId = patientId;
}

void freeBed(Bed beds[], int bedNo) {
    beds[bedNo - 1].occupied = false;
    beds[bedNo - 1].patientId = 0;
}

void displayBeds(Bed beds[]) {
    cout << "\n------------ BED STATUS ------------\n";
    int free = 0;
    for (int i = 0; i < MAX_BEDS; i++) {
        cout << "Bed " << beds[i].bedNo << " : ";
        if (beds[i].occupied)
            cout << "Occupied (Patient ID " << beds[i].patientId << ")\n";
        else {
            cout << "Free\n";
            free++;
        }
    }
    cout << "Free beds: " << free << " / " << MAX_BEDS << "\n";
}

/* ------------------------------------------------------------------ */
/*                  DOUBLY LINKED LIST OPERATIONS                      */
/* ------------------------------------------------------------------ */

Patient* searchById(PatientList &list, int id) {
    Patient *temp = list.head;
    while (temp != NULL) {
        if (temp->id == id) return temp;
        temp = temp->next;
    }
    return NULL;
}

string toLower(string s) {
    for (size_t i = 0; i < s.length(); i++)
        if (s[i] >= 'A' && s[i] <= 'Z') s[i] = s[i] + 32;
    return s;
}

// Insert a node at the end of the list
void insertEnd(PatientList &list, int id, string name, int age,
               string disease, int bedNo) {
    Patient *p = new Patient;
    p->id = id;
    p->name = name;
    p->age = age;
    p->disease = disease;
    p->bedNo = bedNo;
    p->next = NULL;
    p->prev = list.tail;

    if (list.head == NULL)
        list.head = list.tail = p;
    else {
        list.tail->next = p;
        list.tail = p;
    }
    list.count++;
}

// Remove a node from the list (does not free it, caller deletes)
void unlinkNode(PatientList &list, Patient *p) {
    if (p->prev != NULL) p->prev->next = p->next;
    else                 list.head = p->next;      // deleting first node

    if (p->next != NULL) p->next->prev = p->prev;
    else                 list.tail = p->prev;      // deleting last node

    list.count--;
}

void printPatient(Patient *p) {
    cout << "ID: " << p->id << " | Name: " << p->name
         << " | Age: " << p->age << " | Disease: " << p->disease
         << " | Bed: " << p->bedNo << "\n";
}

/* ------------------------------------------------------------------ */
/*                           MENU FUNCTIONS                            */
/* ------------------------------------------------------------------ */

void addPatient(PatientList &list, Bed beds[]) {
    cout << "\n--- ADMIT NEW PATIENT ---\n";
    int bedNo = findFreeBed(beds);
    if (bedNo == -1) {
        cout << "Sorry, no beds available. Cannot admit more patients.\n";
        return;
    }

    int id = readInt("Enter Patient ID: ", 1, 999999);
    if (searchById(list, id) != NULL) {
        cout << "A patient with this ID already exists!\n";
        return;
    }
    string name = readText("Enter Name: ");
    int age = readInt("Enter Age (0-120): ", 0, 120);
    string disease = readText("Enter Disease: ");

    insertEnd(list, id, name, age, disease, bedNo);
    allocateBed(beds, bedNo, id);
    cout << "Patient admitted successfully. Bed " << bedNo << " allotted.\n";
}

void dischargePatient(PatientList &list, Bed beds[], Stack &history) {
    cout << "\n--- DISCHARGE PATIENT ---\n";
    if (list.head == NULL) {
        cout << "No patients admitted.\n";
        return;
    }
    if (isStackFull(history)) {
        cout << "Discharge history is full. Cannot discharge more.\n";
        return;
    }
    int id = readInt("Enter Patient ID to discharge: ", 1, 999999);
    Patient *p = searchById(list, id);
    if (p == NULL) {
        cout << "Patient not found.\n";
        return;
    }

    // save record in stack (history)
    DischargedRecord r;
    r.id = p->id;
    r.name = p->name;
    r.age = p->age;
    r.disease = p->disease;
    r.bedNo = p->bedNo;
    push(history, r);

    freeBed(beds, p->bedNo);
    unlinkNode(list, p);
    cout << "Patient " << p->name << " discharged. Bed " << p->bedNo
         << " is now free.\n";
    delete p;
}

void searchPatient(PatientList &list) {
    cout << "\n--- SEARCH PATIENT ---\n";
    cout << "1. Search by ID\n2. Search by Name\n";
    int ch = readInt("Enter choice: ", 1, 2);

    if (ch == 1) {
        int id = readInt("Enter Patient ID: ", 1, 999999);
        Patient *p = searchById(list, id);
        if (p) { cout << "Patient found:\n"; printPatient(p); }
        else cout << "Patient not found.\n";
    } else {
        string name = toLower(readText("Enter Name: "));
        bool found = false;
        Patient *temp = list.head;
        while (temp != NULL) {
            if (toLower(temp->name) == name) {
                if (!found) cout << "Patient(s) found:\n";
                printPatient(temp);
                found = true;
            }
            temp = temp->next;
        }
        if (!found) cout << "Patient not found.\n";
    }
}

void displayForward(PatientList &list) {
    cout << "\n--- PATIENT RECORDS (Oldest to Newest) ---\n";
    if (list.head == NULL) { cout << "No patients admitted.\n"; return; }
    Patient *temp = list.head;
    while (temp != NULL) {
        printPatient(temp);
        temp = temp->next;
    }
    cout << "Total patients: " << list.count << "\n";
}

void displayBackward(PatientList &list) {
    cout << "\n--- PATIENT RECORDS (Newest to Oldest) ---\n";
    if (list.tail == NULL) { cout << "No patients admitted.\n"; return; }
    Patient *temp = list.tail;
    while (temp != NULL) {
        printPatient(temp);
        temp = temp->prev;
    }
    cout << "Total patients: " << list.count << "\n";
}

void undoDischarge(PatientList &list, Bed beds[], Stack &history) {
    cout << "\n--- UNDO LAST DISCHARGE ---\n";
    if (isStackEmpty(history)) {
        cout << "No discharge history available.\n";
        return;
    }
    DischargedRecord r = history.data[history.top];

    // try to give back the same bed, otherwise any free bed
    int bedNo = r.bedNo;
    if (beds[bedNo - 1].occupied) bedNo = findFreeBed(beds);
    if (bedNo == -1) {
        cout << "No bed available to re-admit the patient.\n";
        return;
    }
    if (searchById(list, r.id) != NULL) {
        cout << "A patient with this ID is already admitted.\n";
        return;
    }

    pop(history, r);
    insertEnd(list, r.id, r.name, r.age, r.disease, bedNo);
    allocateBed(beds, bedNo, r.id);
    cout << "Patient " << r.name << " re-admitted in Bed " << bedNo << ".\n";
}

void displayHistory(Stack &history) {
    cout << "\n--- DISCHARGE HISTORY (Latest first) ---\n";
    if (isStackEmpty(history)) { cout << "No patients discharged yet.\n"; return; }
    for (int i = history.top; i >= 0; i--) {
        cout << "ID: " << history.data[i].id
             << " | Name: " << history.data[i].name
             << " | Age: " << history.data[i].age
             << " | Disease: " << history.data[i].disease
             << " | Bed was: " << history.data[i].bedNo << "\n";
    }
}

void freeAll(PatientList &list) {
    Patient *temp = list.head;
    while (temp != NULL) {
        Patient *nx = temp->next;
        delete temp;
        temp = nx;
    }
    list.head = list.tail = NULL;
    list.count = 0;
}

/* ------------------------------------------------------------------ */
/*                               MAIN                                  */
/* ------------------------------------------------------------------ */

int main() {
    PatientList list;
    Bed beds[MAX_BEDS];
    Stack history;

    initList(list);
    initBeds(beds);
    initStack(history);

    int choice;
    do {
        cout << "\n=========================================\n";
        cout << "   HOSPITAL PATIENT MANAGEMENT SYSTEM\n";
        cout << "=========================================\n";
        cout << "1. Admit new patient\n";
        cout << "2. Discharge patient\n";
        cout << "3. Search patient\n";
        cout << "4. Display all patients (forward)\n";
        cout << "5. Display all patients (backward)\n";
        cout << "6. Show bed status\n";
        cout << "7. Undo last discharge\n";
        cout << "8. Show discharge history\n";
        cout << "0. Exit\n";
        choice = readInt("Enter your choice: ", 0, 8);

        switch (choice) {
            case 1: addPatient(list, beds); break;
            case 2: dischargePatient(list, beds, history); break;
            case 3: searchPatient(list); break;
            case 4: displayForward(list); break;
            case 5: displayBackward(list); break;
            case 6: displayBeds(beds); break;
            case 7: undoDischarge(list, beds, history); break;
            case 8: displayHistory(history); break;
            case 0: cout << "Exiting... Thank you!\n"; break;
        }
    } while (choice != 0);

    freeAll(list);
    return 0;
}